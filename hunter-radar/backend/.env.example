# 复制为 .env 后填入实际值
APP_NAME=Hunter Radar V1.4
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://hunter:hunter@localhost:5432/hunter_radar
DATABASE_URL_SYNC=postgresql+psycopg2://hunter:hunter@localhost:5432/hunter_radar

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-only-change-me-in-prod-32-bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Stripe(可选,开发期留空)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Web Push VAPID(可选,开发期留空)
# 注意:code 读 HR_VAPID_* 前缀(避免被其他组件用同名 VAPID_* 污染),键名严格匹配。
HR_VAPID_PRIVATE_KEY=
HR_VAPID_PUBLIC_KEY=
HR_VAPID_CLAIMS_EMAIL=mailto:admin@example.com
# 生成方式:`npx web-push generate-vapid-keys` 或 `python -c "from py_vapid import *; print(*create_vapid())"` 即可获得一对 base64url。留空 → push service 降级 no-op。

# Sentry
SENTRY_DSN=

# Threat Score
THREAT_RED_THRESHOLD=70
THREAT_RED_THRESHOLD_PANIC=80
EMA_HALFLIFE_DAYS=2

# Backtest
BACKTEST_HISTORY_YEARS=2
BACKTEST_GOLDSET_MIN_EVENTS=30

# Quota
FREE_TIER_DAILY_QUOTA=3

# LLM (OpenAI 兼容,使用 DeepSeek) — Hunter-Radar frontend 调 /llm/analyze 时用
# 从 workspace/.env.secrets 灌入,或者用 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
